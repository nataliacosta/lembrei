rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      return request.auth != null;
    }

    function papelNaFrente(frenteId) {
      return get(/databases/$(database)/documents/frentes/$(frenteId)).data.membros[request.auth.uid];
    }

    // Usa o campo membrosUids que já fica copiado no próprio item (em vez de
    // um get() na frente "pai"). Necessário pras buscas do painel geral
    // (collectionGroup em "itens", que cruza várias frentes de uma vez) —
    // ali a própria consulta já filtra por membrosUids, então o Firestore
    // consegue confirmar que a regra é segura sem rodar por documento.
    function ehMembroDoItem() {
      return logado() && request.auth.uid in resource.data.membrosUids;
    }

    // Para listar TODOS os itens de uma frente (sem filtrar por membrosUids
    // na própria consulta, como a tela da frente faz), o Firestore só aceita
    // a leitura se conseguir provar a regra sem depender dos dados de cada
    // documento — por isso aqui checamos a frente "pai" (get(), caminho
    // fixo), e não o campo membrosUids do item (que poderia estar
    // desatualizado e faria a consulta inteira ser negada).
    function ehMembro(frenteId) {
      return logado() && request.auth.uid in get(/databases/$(database)/documents/frentes/$(frenteId)).data.membrosUids;
    }

    function podeEditar(frenteId) {
      return logado() && papelNaFrente(frenteId) in ['proprietario', 'editor'];
    }

    function ehProprietario(frenteId) {
      return logado() && papelNaFrente(frenteId) == 'proprietario';
    }

    // Permite que a própria pessoa convidada se adicione à frente no primeiro
    // login, sem precisar de Cloud Function: só pode acrescentar o próprio uid
    // (nunca mudar outros membros), e só se o e-mail dela estiver na lista de
    // convites pendentes, com papel editor ou visualizador (nunca proprietário).
    function aceitandoConvite() {
      return logado()
        && !(request.auth.uid in resource.data.membrosUids)
        && request.auth.token.email in resource.data.convitesPendentesEmails
        && request.auth.uid in request.resource.data.membrosUids
        && request.resource.data.membros[request.auth.uid] in ['editor', 'visualizador']
        && request.resource.data.donoId == resource.data.donoId
        && request.resource.data.membros.diff(resource.data.membros).affectedKeys().hasOnly([request.auth.uid]);
    }

    // Qualquer membro (que não seja a dona) pode sair de uma frente: só tira o
    // próprio uid de membros/membrosUids, sem mexer em mais nada. Usado para
    // sair da antiga frente "Contratos" compartilhada (contratos-padrao).
    function saindoDaFrente() {
      return logado()
        && request.auth.uid in resource.data.membrosUids
        && request.auth.uid != resource.data.donoId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['membros', 'membrosUids'])
        && request.resource.data.membrosUids == resource.data.membrosUids.removeAll([request.auth.uid])
        && request.resource.data.membros.diff(resource.data.membros).affectedKeys().hasOnly([request.auth.uid])
        && !(request.auth.uid in request.resource.data.membros);
    }

    // A frente "Contratos" de cada pessoa tem o ID contratos-<uid>.
    function minhaFrenteContratos(frenteId) {
      return logado() && frenteId == 'contratos-' + request.auth.uid;
    }

    // Regra de leitura separada, no nível raiz, com curinga recursivo
    // ({path=**}): é o padrão exigido pelo Firestore pra consultas
    // collectionGroup (como a do painel geral, que cruza todas as frentes de
    // uma vez) — uma regra "read" aninhada dentro de /frentes/{frenteId} não
    // é aplicada nesse tipo de consulta.
    match /{path=**}/itens/{itemId} {
      allow read: if ehMembroDoItem();
    }

    // ---------- Contratos ----------

    function papelNoContrato(contratoId) {
      return get(/databases/$(database)/documents/contratos/$(contratoId)).data.membros[request.auth.uid];
    }

    function podeEditarContrato(contratoId) {
      return logado() && papelNoContrato(contratoId) in ['proprietario', 'editor'];
    }

    function ehProprietarioContrato(contratoId) {
      return logado() && papelNoContrato(contratoId) == 'proprietario';
    }

    function aceitandoConviteContrato() {
      return logado()
        && !(request.auth.uid in resource.data.membrosUids)
        && request.auth.token.email in resource.data.convitesPendentesEmails
        && request.auth.uid in request.resource.data.membrosUids
        && request.resource.data.membros[request.auth.uid] in ['editor', 'visualizador']
        && request.resource.data.donoId == resource.data.donoId
        && request.resource.data.membros.diff(resource.data.membros).affectedKeys().hasOnly([request.auth.uid]);
    }

    // Mesma lógica de ehMembroDoItem/ehMembro, aplicada a aditivos: a versão
    // por campo (collectionGroup, usada pelo painel geral) e a versão por
    // get() na frente "pai" (listagem direta de todos os aditivos de UM
    // contrato, na tela do contrato).
    function ehMembroDoAditivo() {
      return logado() && request.auth.uid in resource.data.membrosUids;
    }

    function ehMembroContrato(contratoId) {
      return logado() && request.auth.uid in get(/databases/$(database)/documents/contratos/$(contratoId)).data.membrosUids;
    }

    match /{path=**}/aditivos/{aditivoId} {
      allow read: if ehMembroDoAditivo();
    }

    match /contratos/{contratoId} {
      // Quem foi convidado (por e-mail) também lê, para conseguir aceitar o
      // convite no próximo login (ver resgatarConvitesPendentesContratos).
      allow read: if logado()
        && (request.auth.uid in resource.data.membrosUids
            || request.auth.token.email in resource.data.convitesPendentesEmails);
      allow create: if logado()
        && request.auth.uid == request.resource.data.donoId
        && request.auth.uid in request.resource.data.membrosUids;
      allow update: if ehProprietarioContrato(contratoId)
        || (podeEditarContrato(contratoId)
            && request.resource.data.membros == resource.data.membros
            && request.resource.data.membrosUids == resource.data.membrosUids
            && request.resource.data.donoId == resource.data.donoId)
        || aceitandoConviteContrato();
      allow delete: if ehProprietarioContrato(contratoId);

      match /aditivos/{aditivoId} {
        allow read: if ehMembroContrato(contratoId);
        allow create, delete: if podeEditarContrato(contratoId);
        // Mesma regra de sincronização dos itens de frente: qualquer membro
        // pode copiar a lista de membros do contrato para o aditivo.
        allow update: if podeEditarContrato(contratoId)
          || (ehMembroContrato(contratoId)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['membrosUids'])
              && request.resource.data.membrosUids == get(/databases/$(database)/documents/contratos/$(contratoId)).data.membrosUids);

        match /comentarios/{comentarioId} {
          allow read: if ehMembroContrato(contratoId);
          allow create: if logado()
            && ehMembroContrato(contratoId)
            && request.resource.data.autorId == request.auth.uid;
          allow update: if logado()
            && request.auth.uid == resource.data.autorId
            && request.resource.data.autorId == resource.data.autorId;
          allow delete: if logado() && request.auth.uid == resource.data.autorId;
        }
      }

      match /cancelamentos/{cancelamentoId} {
        allow read: if ehMembroContrato(contratoId);
        allow create, update, delete: if podeEditarContrato(contratoId);
      }

      // Medições por planilha: CCs/ODIs, recursos (com alocações por mês) e
      // medições salvas. Quem participa do contrato vê; quem edita, muda.
      match /centros/{centroId} {
        allow read: if ehMembroContrato(contratoId);
        allow create, update: if podeEditarContrato(contratoId)
          && request.resource.data.tipo in ['CC', 'ODI']
          && request.resource.data.codigo is string
          && request.resource.data.codigo.size() > 0
          && request.resource.data.codigo.size() <= 60;
        allow delete: if podeEditarContrato(contratoId);
      }

      match /recursos/{recursoId} {
        allow read: if ehMembroContrato(contratoId);
        allow create, update: if podeEditarContrato(contratoId)
          && request.resource.data.nome is string
          && request.resource.data.nome.size() > 0
          && request.resource.data.nome.size() <= 200
          && request.resource.data.alocacoes is list
          && request.resource.data.alocacoes.size() <= 120;
        allow delete: if podeEditarContrato(contratoId);
      }

      match /medicoes/{mes} {
        allow read: if ehMembroContrato(contratoId);
        allow create, update: if podeEditarContrato(contratoId)
          && mes.matches('^[0-9]{4}-[0-9]{2}$')
          && request.resource.data.mes == mes
          && request.resource.data.status in ['a_lancar', 'lancada']
          && request.resource.data.linhas is list;
        allow delete: if podeEditarContrato(contratoId);
      }

      // Itens do contrato (e dos aditivos dele, com aditivoId): quem tem
      // acesso ao contrato vê; quem pode editar o contrato cria e muda.
      match /itens/{itemId} {
        allow read: if ehMembroContrato(contratoId);
        allow create, delete: if podeEditarContrato(contratoId);
        // Qualquer membro pode copiar a lista de membros do contrato para o
        // item (ao aceitar um convite, mesmo só podendo visualizar).
        allow update: if podeEditarContrato(contratoId)
          || (ehMembroContrato(contratoId)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['membrosUids'])
              && request.resource.data.membrosUids == get(/databases/$(database)/documents/contratos/$(contratoId)).data.membrosUids);

        match /comentarios/{comentarioId} {
          allow read: if ehMembroContrato(contratoId);
          // Quem pode editar o contrato também grava comentários de outras
          // pessoas: é a cópia feita ao trazer itens das antigas frentes Contratos.
          allow create: if ehMembroContrato(contratoId)
            && (request.resource.data.autorId == request.auth.uid || podeEditarContrato(contratoId));
          allow update: if logado()
            && request.auth.uid == resource.data.autorId
            && request.resource.data.autorId == resource.data.autorId;
          allow delete: if logado() && request.auth.uid == resource.data.autorId;
        }
      }
    }

    match /usuarios/{uid} {
      allow read: if logado();
      allow write: if logado() && request.auth.uid == uid;

      // Aparelhos com notificação push ativada: só a própria pessoa vê e
      // mexe (as Cloud Functions leem pelo Admin SDK).
      match /dispositivos/{dispositivoId} {
        allow read, delete: if logado() && request.auth.uid == uid;
        allow create, update: if logado() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['endpoint', 'keys', 'nome', 'criadoEm'])
          && request.resource.data.endpoint is string
          && request.resource.data.endpoint.matches('https://.*');
      }
      // pushEnviados (controle das Cloud Functions): sem acesso pelo app.
    }

    match /frentes/{frenteId} {
      // Quem foi convidado (por e-mail) também lê, para conseguir aceitar o
      // convite no próximo login (ver resgatarConvitesPendentes). A própria
      // frente Contratos pode ser lida mesmo antes de existir (para criá-la).
      allow read: if minhaFrenteContratos(frenteId)
        || (logado()
            && (request.auth.uid in resource.data.membrosUids
                || request.auth.token.email in resource.data.convitesPendentesEmails));
      // Uma frente com ID "contratos-<uid>" só pode ser criada pela própria
      // pessoa (é a frente Contratos dela).
      allow create: if logado()
        && request.auth.uid == request.resource.data.donoId
        && request.auth.uid in request.resource.data.membrosUids
        && (!frenteId.matches('contratos-.*') || minhaFrenteContratos(frenteId));
      allow update: if ehProprietario(frenteId)
        || (podeEditar(frenteId)
            && request.resource.data.membros == resource.data.membros
            && request.resource.data.membrosUids == resource.data.membrosUids
            && request.resource.data.donoId == resource.data.donoId)
        || aceitandoConvite()
        || saindoDaFrente();
      allow delete: if ehProprietario(frenteId);

      match /itens/{itemId} {
        allow read: if ehMembro(frenteId);
        allow create: if podeEditar(frenteId);
        // Qualquer membro da frente pode sincronizar só o campo membrosUids
        // (usado nas consultas do painel geral), e só copiando a lista atual
        // da frente — é o que acontece quando alguém aceita um convite, mesmo
        // com acesso "Pode visualizar". Qualquer outra mudança exige edição.
        // Quem está na lista do item também pode só se tirar dela (ao sair
        // da antiga frente Contratos compartilhada).
        allow update: if podeEditar(frenteId)
          || (ehMembro(frenteId)
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['membrosUids'])
              && request.resource.data.membrosUids == get(/databases/$(database)/documents/frentes/$(frenteId)).data.membrosUids)
          || (logado()
              && request.auth.uid in resource.data.membrosUids
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['membrosUids'])
              && request.resource.data.membrosUids == resource.data.membrosUids.removeAll([request.auth.uid]));
        // Na antiga frente compartilhada, quem criou o item pode apagá-lo
        // (depois de copiá-lo para a própria frente Contratos).
        allow delete: if podeEditar(frenteId)
          || (logado() && frenteId == 'contratos-padrao' && resource.data.criadoPor == request.auth.uid);

        match /comentarios/{comentarioId} {
          // Qualquer pessoa com acesso à frente comenta e lê comentários,
          // mesmo quem só pode visualizar. Quem está na lista do item também
          // lê (para levar os comentários junto ao mudar o item de frente).
          allow read: if logado()
            && (request.auth.uid in get(/databases/$(database)/documents/frentes/$(frenteId)).data.membrosUids
                || request.auth.uid in get(/databases/$(database)/documents/frentes/$(frenteId)/itens/$(itemId)).data.membrosUids);
          // Quem pode editar a frente também grava comentários de outras
          // pessoas: é a cópia feita ao mudar um item de lugar.
          allow create: if logado()
            && request.auth.uid in get(/databases/$(database)/documents/frentes/$(frenteId)).data.membrosUids
            && (request.resource.data.autorId == request.auth.uid || podeEditar(frenteId));
          allow update: if logado()
            && request.auth.uid == resource.data.autorId
            && request.resource.data.autorId == resource.data.autorId;
          allow delete: if logado() && request.auth.uid == resource.data.autorId;
        }
      }
    }

    // ---------- Fila de demandas ----------
    // filas/{donoId}: o id é o uid do dono. Membros convidados podem ver ou
    // editar (repriorizar, criar e atualizar demandas), nunca mudar o acesso.

    function papelNaFila(donoId) {
      return get(/databases/$(database)/documents/filas/$(donoId)).data.membros[request.auth.uid];
    }

    function podeVerFila(donoId) {
      return logado() && (request.auth.uid == donoId || request.auth.uid in get(/databases/$(database)/documents/filas/$(donoId)).data.membrosUids);
    }

    function podeEditarFila(donoId) {
      return logado() && (request.auth.uid == donoId || papelNaFila(donoId) == 'editor');
    }

    function aceitandoConviteFila() {
      return logado()
        && !(request.auth.uid in resource.data.membrosUids)
        && request.auth.token.email in resource.data.convitesPendentesEmails
        && request.auth.uid in request.resource.data.membrosUids
        && request.resource.data.membros[request.auth.uid] in ['editor', 'visualizador']
        && request.resource.data.donoId == resource.data.donoId
        && request.resource.data.membros.diff(resource.data.membros).affectedKeys().hasOnly([request.auth.uid]);
    }

    match /filas/{donoId} {
      // Quem foi convidado precisa conseguir ler a fila para aceitar o convite.
      allow read: if logado()
        && (request.auth.uid == donoId
            || request.auth.uid in resource.data.membrosUids
            || request.auth.token.email in resource.data.convitesPendentesEmails);
      allow create: if logado()
        && request.auth.uid == donoId
        && request.resource.data.donoId == donoId
        && request.resource.data.membros[donoId] == 'proprietario';
      allow update: if (logado() && request.auth.uid == donoId && request.resource.data.donoId == donoId)
        || (logado() && resource.data.membros[request.auth.uid] == 'editor'
            && request.resource.data.membros == resource.data.membros
            && request.resource.data.membrosUids == resource.data.membrosUids
            && request.resource.data.donoId == resource.data.donoId)
        || aceitandoConviteFila();
      allow delete: if false;

      match /demandas/{demandaId} {
        allow read: if podeVerFila(donoId);
        allow create, update, delete: if podeEditarFila(donoId);
      }
    }

    // ---------- Notificações ----------
    // Cada pessoa só lê, marca como lida e apaga as próprias. Quem cria o
    // aviso é quem fez a ação (autorId precisa ser a própria conta).
    match /notificacoes/{notificacaoId} {
      allow read, delete: if logado() && resource.data.destinatarioId == request.auth.uid;
      allow create: if logado()
        && request.resource.data.autorId == request.auth.uid
        && request.resource.data.lida == false
        && request.resource.data.keys().hasOnly(['destinatarioId', 'autorId', 'autorNome', 'autorFoto', 'tipo', 'alvo', 'contexto', 'trecho', 'link', 'lida', 'criadoEm'])
        && request.resource.data.tipo in ['comentario', 'mencao', 'atribuido', 'aditivo', 'demanda_criada', 'demanda_priorizada', 'demanda_parada', 'demanda_retomada', 'fila_repriorizada', 'convite_recebido', 'convite_aceito']
        && request.resource.data.trecho.size() <= 300;
      allow update: if logado()
        && resource.data.destinatarioId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lida']);
    }
  }
}
